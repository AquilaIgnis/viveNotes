    <string name="account_self_host_description">Connect to your own ViveNotes server.</string>
    <string name="account_server_url">Server URL</string>
    <string name="account_server_url_example">https://notes.example.com</string>
    <string name="account_email">Email</string>
    <string name="account_password">Password</string>
    <string name="account_connect">Connect</string>
