    <string name="account_connected_title">Connected</string>
    <string name="account_connected_device">Registered as %1$s</string>
    <string name="account_sync_now">Sync now</string>
    <string name="account_syncing">Syncing notebooks</string>
    <string name="account_sync_up_to_date">Up to date</string>
    <string name="account_sync_summary">Up to date · Pulled: %1$d · Pushed: %2$d</string>
    <!--
        The ambient sync line. It answers "is this tablet current", so it is written as a time rather
        than as a verdict: "Synced just now" needs no interpretation, and a stale one is visible
        without reading the rest of the sentence.
    -->
    <string name="account_sync_just_now">Synced just now</string>
    <string name="account_sync_relative">Synced %1$s</string>
    <string name="account_sync_counts"> · Pulled %1$d · Pushed %2$d</string>
    <string name="account_sync_pictures"> · %1$d pictures</string>
    <string name="account_sync_never">Not synced yet</string>
    <string name="account_sync_will_retry">%1$s Syncing will retry by itself.</string>
    <string name="account_sync_error_response">The server returned sync data this version cannot read.</string>
    <string name="account_sync_error_local">The local sync queue could not be read. The notes themselves are still stored locally.</string>
    <string name="account_sync_error_large">One local hierarchy change is larger than the server accepts.</string>
    <string name="account_sync_error_malformed">The server rejected one local hierarchy change as malformed.</string>
    <string name="account_sync_error_unsupported">This account holds changes a newer version of the app wrote. Update ViveNotes to keep syncing.</string>
    <string name="account_sync_error_parent">A section or page could not be sent because its parent is missing.</string>
    <string name="account_disconnect_failed">The device could not be revoked. Its token was kept so you can try again.</string>
    <!--
        Offered only after a revoke has already failed. It names the one thing that stays behind,
        because that is the whole difference between this and the ordinary disconnect: nobody tells
        the server, so the device outlives this app's copy of its token.
    -->
    <string name="account_disconnect_anyway_note">Server did not respond</string>
    <string name="account_disconnect_anyway">Forget Server</string>
    <string name="account_disconnecting">Revoking this device</string>
    <string name="account_disconnect">Disconnect</string>
    <string name="account_disconnect_title">Disconnect from this server?</string>
    <!--
        Says what cannot be undone rather than "are you sure": the token is not recoverable, and the
        device row it belongs to outlives it on the server until somebody removes it.
    -->
    <string name="account_disconnect_body">The server will revoke this device. Notes already on this device stay here.</string>
    <string name="account_disconnect_cancel">Cancel</string>
    <!--
        One message per ConnectFailure. Each names what to change, because the person reading it is
        the same person who runs the server: "could not connect" tells them nothing they cannot see.
    -->
    <string name="account_error_address">That is not a server address. Try something like https://notes.example.com.</string>
    <string name="account_error_unreachable">Nothing answered at that address. Check the address and port.</string>
    <string name="account_error_credentials">That email and password do not match an account on this server.</string>
    <string name="account_error_request">The server would not accept those details. Check the email address, and that the password is at least 8 characters.</string>
    <string name="account_error_too_large">Those details are longer than the server accepts.</string>
    <string name="account_error_server">The server could not complete the request. Check its logs, then try again.</string>
    <string name="account_error_not_vive">Something answered at that address, but it is not a ViveNotes server.</string>
    <string name="account_error_revoked">This device\'s access was revoked on the server, so it has been disconnected. Sign in again to register it.</string>
    <string name="account_error_not_stored">This device registered with the server, but its token could not be saved, so it cannot be used. Free some storage and connect again — the unused device can be removed from the server\'s dashboard.</string>
    <!--
        The closed-notebook shelf. "Closed" rather than "archived": nothing here has been put away
        for keeping, and the notebook is one press from being back where it was.
    -->
    <string name="closed_notebooks">Closed Notebooks</string>
    <string name="closed_notebooks_empty">No notebooks are closed. Closing one takes it off the panel without deleting anything.</string>
    <string name="closed_notebooks_on_device">On this device</string>
    <string name="closed_notebooks_in_cloud">In the cloud</string>
    <!--
        Says what is missing rather than what is present, because that is the part with a
        consequence: a notebook whose pages are on the server cannot be searched or opened offline.
    -->
    <string name="closed_notebooks_in_cloud_supporting">These notebooks\' pages are on your server and not on this device, so they cannot be searched or opened until you bring one back.</string>
    <string name="closed_notebooks_no_account">Connect an account on the Account screen to bring these back.</string>
    <string name="closed_notebook_contents">%1$d sections · %2$d pages</string>
    <string name="closed_notebook_open">Open</string>
    <string name="closed_notebook_move_to_cloud">Move to cloud</string>
    <!-- Content description for the cloud-download icon button; the shelf shows no label there. -->
    <string name="closed_notebook_bring_back">Bring back to this device</string>
    <!--
        One line per CloudArchiveResult that is worth reporting. Each says what to do next, because
        every one of them is recoverable by doing something.
    -->
    <string name="closed_notebook_needs_account">Connect a server on the Account screen first. Moving a notebook to the cloud needs somewhere to put it.</string>
    <string name="closed_notebook_not_uploaded">This device still has %1$d changes to upload. Nothing was removed — try again once syncing has caught up.</string>
    <string name="closed_notebook_gone">That notebook is no longer here.</string>
    <string name="closed_notebook_failed">The notebook could not be moved. Nothing was removed from this device.</string>
    <string name="closed_notebook_restore_failed">The notebook could not be brought back. It is still on the server.</string>
</resources>
